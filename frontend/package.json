{
  "name": "frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint new-frontend",
    "vitest": "vitest --run",
    "vitest:ui": "vitest --ui",
    "vitest:coverage": "vitest --coverage",
    "generate-coverage-report": "npx nyc report --reporter=text --reporter=html --report-dir=coverage/total",
    "cypress:component": "npx cypress run --component",
    "test:e2e": "npx cypress run",
    "test": "npm run vitest && npm run cypress:component",
    "docs": "typedoc --out docs/typedoc src/ --entryPointStrategy expand"
  },
  "dependencies": {
    "@headlessui/react": "2.2.0",
    "@heroicons/react": "2.2.0",
    "@reduxjs/toolkit": "2.6.1",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/vite": "4.0.17",
    "@tanstack/react-query": "5.71.1",
    "axios": "1.8.4",
    "date-fns": "4.1.0",
    "formik": "2.4.6",
    "jose": "6.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "9.2.0",
    "react-router-dom": "7.4.1",
    "redux-saga": "1.3.0",
    "tailwindcss": "4.0.17",
    "yup": "1.6.1"
  },
  "devDependencies": {
    "@cypress/code-coverage": "3.14.0",
    "@eslint/js": "9.23.0",
    "@storybook/addon-actions": "8.6.11",
    "@storybook/addon-essentials": "8.6.11",
    "@storybook/addon-links": "8.6.11",
    "@storybook/node-logger": "8.6.11",
    "@storybook/react": "8.6.11",
    "@storybook/react-vite": "8.6.11",
    "@tailwindcss/vite": "4.0.17",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.16",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-istanbul": "3.1.1",
    "@vitest/ui": "3.1.1",
    "axios-mock-adapter": "2.1.0",
    "cypress": "14.2.1",
    "eslint": "9.23.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "nyc": "17.1.0",
    "typedoc": "0.28.1",
    "typescript": "5.8.2",
    "typescript-eslint": "8.29.0",
    "vite": "6.2.4",
    "vite-plugin-istanbul": "6.0.2",
    "vitest": "3.1.1"
  }
}
